# Gemini vision model. Configure these as Supabase Edge Function secrets only.
# Keep GEMINI_API_KEY server-side; never add a VITE_ prefix.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash
OTP_PEPPER=generate_at_least_32_random_bytes
BOT_OTP_SECRET=match_bot_env_example
BOT_ADMIN_SECRET=match_bot_env_example
BOT_QUEUE_SECRET=match_bot_env_example
BOT_P2P_SECRET=match_bot_env_example
APP_ORIGIN=https://your-main-domain.example
ADMIN_APP_ORIGIN=https://your-admin-domain.example
APP_ORIGINS=https://your-main-domain.example,https://your-admin-domain.example
TURNSTILE_SECRET_KEY=YOUR_CLOUDFLARE_TURNSTILE_SECRET

# Cloudflare Stream upload and signed HLS playback. These values are server-only.
CF_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CF_STREAM_API_TOKEN=YOUR_CLOUDFLARE_STREAM_API_TOKEN
CF_STREAM_CUSTOMER_CODE=YOUR_STREAM_CUSTOMER_CODE

# Web Push uses a public browser key plus private VAPID key stored only on the server.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
PUSH_REMINDER_SECRET=AT_LEAST_32_RANDOM_BYTES

# Payme hosted checkout. Select with PAYMENT_PROVIDER=payme. Keep these values in Edge Function secrets.
PAYMENT_PROVIDER=payme
PAYME_MERCHANT_ID=YOUR_PAYME_MERCHANT_ID
PAYME_SECRET_KEY=YOUR_PAYME_MERCHANT_SECRET
GYM_QR_SIGNING_SECRET=AT_LEAST_32_RANDOM_BYTES
GYM_LEADS_CHAT_ID=YOUR_GYM_ADMIN_CHAT_ID

# Optional legacy Lemon Squeezy store; use only if you already have an active merchant account.
LEMONSQUEEZY_API_KEY=YOUR_LEMONSQUEEZY_API_KEY
LEMONSQUEEZY_STORE_ID=YOUR_LEMONSQUEEZY_STORE_ID
LEMONSQUEEZY_WEBHOOK_SECRET=YOUR_LEMONSQUEEZY_WEBHOOK_SECRET
